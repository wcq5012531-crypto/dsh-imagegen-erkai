node_modules/
# `lib/` 是构建产物，但**要入库**：插件市场/git 安装不会替用户跑一次 `tsdown`
# （pnpm 默认禁止 git 包执行构建脚本），包里没有 lib/ 就装不上、或者要用户手工
# 改 allowBuilds。源码地图 4MB，没有安装价值，单独排除。
/lib/*.map
*.tgz
.build-lock/
# Upstream port plans (diff + extracted source). Generated per run, never
# shipped: the classification is read once and the tree that matters is this one.
/.upstream/
# 推广片逐帧渲染的中间产物（900 帧 × 两版，约 300MB）。成片与源文件在 docs/promo/。
/docs/promo/src/frames/
# `pnpm run ppt:preview` 的产物：单文件组件预览包，用于 pnpm run test:ppt-browser。
/.ppt-preview/
# macOS Finder 目录元数据：每次浏览目录都会重新生成，不属于仓库内容。
.DS_Store

# 上游源码快照（src.zip 等，85MB）：只在本地用于 upstream-sync 比对
/_upstream/
# 临时调试脚本（probe*.mjs / _studio-smoke.mts）：不属于插件源码
/probe*.mjs
/_studio-smoke.mts
# 一次性补丁脚本与跑测日志：每次排查都会生成，属本地产物
/_patch*.mjs
/_runall*.mjs
/_dig*.mjs
/_sb_copy.mjs
/*.log
